{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:step": "tsx prisma/seed/index.ts",
    "db:typecheck": "tsc --noEmit -p prisma/tsconfig.json",
    "db:cek": "tsx prisma/seed/cek-konsistensi.ts",
    "db:verifikasi-tarif": "tsx prisma/seed/verifikasi-tarif.ts",
    "typecheck": "tsc --noEmit",
    "server:cek-closing": "tsx --conditions=react-server src/lib/server/scripts/cek-closing.ts",
    "server:cek-siklus": "tsx --conditions=react-server src/lib/server/scripts/cek-siklus.ts",
    "server:backfill-golongan": "tsx --conditions=react-server src/lib/server/scripts/backfill-golongan-tagihan.ts",
    "server:backfill-jam-catat": "tsx --conditions=react-server src/lib/server/scripts/backfill-jam-catat.ts",
    "server:generate-urut-catat": "tsx --conditions=react-server src/lib/server/scripts/generate-urut-catat.ts",
    "server:perbaiki-jenis-pemutusan": "tsx --conditions=react-server src/lib/server/scripts/perbaiki-jenis-pemutusan.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
